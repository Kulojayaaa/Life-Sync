{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://evdqvwqruclcdxbeztnd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "budget-buddy",
      "version": "0.1.0",
      "title": "Budget Buddy"
    },
    "tools": [
      {
        "name": "list_accounts",
        "title": "List accounts",
        "description": "List the signed-in user's money accounts (name, type and current balance).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "List transactions",
        "description": "List the signed-in user's recent transactions, optionally filtered by date range, type or category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Earliest transaction date, YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "description": "Latest transaction date, YYYY-MM-DD."
            },
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense",
                "transfer"
              ],
              "description": "Only return transactions of this type."
            },
            "category": {
              "type": "string",
              "description": "Exact category name to filter by."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 50, max 200)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_transaction",
        "title": "Record a transaction",
        "description": "Record an income or expense transaction for the signed-in user. Use list_accounts first to pick an account.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string",
              "description": "Account UUID from list_accounts."
            },
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense"
              ],
              "description": "Whether money came in or went out."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Positive amount in the user's currency."
            },
            "category": {
              "type": "string",
              "description": "Category name, e.g. Groceries or Salary."
            },
            "description": {
              "type": "string",
              "description": "Short note about the transaction."
            },
            "transaction_date": {
              "type": "string",
              "description": "Date as YYYY-MM-DD. Defaults to today."
            },
            "payment_mode": {
              "type": "string",
              "description": "How it was paid, e.g. UPI, Cash, Card."
            }
          },
          "required": [
            "account_id",
            "type",
            "amount",
            "category"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "spending_summary",
        "title": "Spending summary",
        "description": "Summarise the signed-in user's income, expenses and per-category spending for a month (YYYY-MM).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "description": "Month as YYYY-MM. Defaults to the current month."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_bills",
        "title": "List bills",
        "description": "List the signed-in user's bills and subscriptions with amounts, due dates and paid status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "unpaid_only": {
              "type": "boolean",
              "description": "When true, return only bills that are not marked paid."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_goals",
        "title": "List goals",
        "description": "List the signed-in user's goals with progress and target dates.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_completed": {
              "type": "boolean",
              "description": "When true, also return goals already completed."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
