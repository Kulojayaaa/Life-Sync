# Supabase (from Project Settings → API)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public web URL used by email confirmation and magic-link callbacks.
# Use http://127.0.0.1:8080 for local development or your final Vercel URL in production.
VITE_APP_URL=

# Server-side scripts only. Never expose this value in VITE_* variables or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: sample user for scripts/seed-sample-data.mjs (create this user in Auth first,
# or sign up once and use that email/password)
SAMPLE_USER_EMAIL=
SAMPLE_USER_PASSWORD=

# Optional: same passphrase you use in the app’s Password Vault (for migration/testing scripts)
SAMPLE_VAULT_KEY=
